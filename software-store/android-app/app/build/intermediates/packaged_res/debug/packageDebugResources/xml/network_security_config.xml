<?xml version="1.0" encoding="utf-8"?>
<!-- network_security_config.xml - 网络安全配置，允许 HTTP 明文请求 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
